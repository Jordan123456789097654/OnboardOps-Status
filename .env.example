# Copy to .env for local testing only. On Railway, set these in the service's Variables tab instead.
# NEVER commit a real .env file.

# A long random secret. Generate one with:  openssl rand -base64 48
KENER_SECRET_KEY=replace_with_a_long_random_secret

# The public address of the status page, no trailing slash.
ORIGIN=https://status.onboardops.org

# Postgres and Redis. On Railway these are references to the add-on services (see README).
DATABASE_URL=postgresql://kener:kener_password@postgres:5432/kener
REDIS_URL=redis://redis:6379

# Railway sets PORT for you. Locally it is 3000.
PORT=3000

# Email for subscriber notices (optional). Use one of the two blocks.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=status@onboardops.org
# SMTP_SECURE=0
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=status@onboardops.org
